# Copie para .env.local e preencha com os dados do projeto Supabase de DESENVOLVIMENTO.
# Nunca coloque aqui a chave secreta (service_role / sb_secret_...): ela só existe
# no servidor (Edge Functions) e no painel do Supabase.

# Painel do Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Painel do Supabase → Project Settings → API Keys → chave publicável (sb_publishable_...)
# Essa chave é pública por natureza; a proteção dos dados vem das políticas RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Ambiente exibido na interface: development | production
VITE_APP_ENV=development

# SECRETO — só para scripts locais (npm run criar-admin). Nunca use o prefixo VITE_ aqui:
# o que começa com VITE_ vai para o navegador. Painel → Project Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=
