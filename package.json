{
  "name": "eu-vou",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Eu Vou — PWA de incentivo à participação de jovens e adolescentes nas atividades da igreja",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verificar": "npm run format:check && npm run lint && npm test && npm run build",
    "criar-admin": "node --env-file-if-exists=.env.local scripts/criar-admin.ts",
    "limpar-fotos-teste": "node --env-file-if-exists=.env.local scripts/limpar-fotos-teste.ts",
    "icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
